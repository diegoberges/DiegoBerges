---
import Education from "../components/Education.astro";
import Experience from "../components/Experience.astro";
import Presentation from "../components/Presentation.astro";
import SectionContainer from "../components/shared/SectionContainer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Diego Berges - Desarrollador y programador web"
  description="Soy Diego Berges, desarrollador web en Zaragoza especializado en Angular, con más de 15 años de experiencia. Descubre mi trayectoria profesional y formación."
>
  <SectionContainer>
    <Presentation />
  </SectionContainer>

  <SectionContainer id="experiencia" title="Experiencia">
    <Experience />
  </SectionContainer>

  <SectionContainer id="estudios" title="Estudios">
    <Education />
  </SectionContainer>
</Layout>
