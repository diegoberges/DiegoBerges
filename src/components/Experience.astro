---
import ExperienceItem from "./ExperienceItem.astro";

const TAGS = {
  ANGULAR: { name: "Angular", class: "bg-red-100 text-red-800" },
  TAILWIND: { name: "Tailwind", class: "bg-blue-100 text-blue-800" },
  MATERIAL: { name: "Material", class: "bg-purple-100 text-purple-800" },
  TYPESCRIPT: { name: "TypeScript", class: "bg-blue-100 text-blue-800" },
  PHP: { name: "PHP", class: "bg-purple-100 text-purple-800" },
  HTML: { name: "HTML", class: "bg-blue-100 text-blue-800" },
  JAVASCRIPT: { name: "JavaScript", class: "bg-purple-100 text-purple-800" },
  BOOTSTRAP: { name: "Bootstrap", class: "bg-purple-100 text-purple-800" },
  NET: { name: ".NET", class: "bg-blue-100 text-blue-800" },
  WPF: { name: "WPF", class: "bg-purple-100 text-purple-800" },
  SQL: { name: "SQL", class: "bg-blue-100 text-blue-800" },
};

const EXPERIENCE = [
  {
    title: "Analista Programador Angular",
    company: "Grupo Oesía",
    location: "Zaragoza",
    startDate: "Abril 2022",
    endDate: "Actualmente",
    description:
      "Trabajo con Angular en su última versión, buscando siempre construir aplicaciones eficientes. Soy responsable de gestionar la entrega continua del código, confeccionando una CI adaptada a cada uno de los proyectos. Además de programar, reviso el código de mis compañeros y me encargo de documentar y mantener al día la arquitectura frontend del proyecto.",
    tags: [
      TAGS.ANGULAR,
      TAGS.TAILWIND,
      TAGS.TYPESCRIPT,
      TAGS.HTML,
      TAGS.JAVASCRIPT,
    ],
  },
  {
    title: "Analista Programador .NET",
    company: "Grupo Oesía",
    location: "Zaragoza",
    startDate: "Mayo 2019",
    endDate: "Abril 2022",
    description:
      "Antes de centrarme en Angular pasé tres años construyendo aplicaciones de escritorio con .NET y WPF, con SQL. Revisaba el código del equipo y ayudaba a coordinarlo.",
    tags: [TAGS.NET, TAGS.WPF, TAGS.SQL],
  },
  {
    title: "Programador Sénior",
    company: "Audinfor System SL",
    location: "Zaragoza",
    startDate: "Noviembre 2015",
    endDate: "Mayo 2019",
    description:
      "Entré como programador web y, con el tiempo, acabé liderando el departamento: coordinando al equipo, definiendo la arquitectura de los proyectos nuevos y asegurándome de que todo, desde el frontend en Angular hasta las integraciones con clientes, funcionara rápido y sin sorpresas.",
    tags: [
      TAGS.ANGULAR,
      TAGS.MATERIAL,
      TAGS.TYPESCRIPT,
      TAGS.HTML,
      TAGS.BOOTSTRAP,
      TAGS.PHP,
    ],
  },
];
---

<ol class="relative border-gray-400 border-s">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
