---
const navItems = [
  { title: "Experiencia", label: "experiencia", url: "#experiencia" },
  { title: "Estudios", label: "estudios", url: "#estudios" },
];
---

<header
  class="fixed top-0 z-20 w-full border-b border-neutral-tertiary bg-neutral-primary/80 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-screen-xl items-center justify-center px-4 py-3"
  >
    <ul class="flex flex-row gap-x-1 text-sm font-medium">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.url}
              aria-label={item.label}
              class="nav-link block rounded-base px-3 py-1.5 text-body transition-colors hover:text-fg-brand"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("header nav a");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          navLinks.forEach((link) => {
            const isActive =
              link.getAttribute("aria-label") === entry.target.id;
            link.classList.toggle("text-fg-brand", isActive);
            link.classList.toggle("font-semibold", isActive);
            link.classList.toggle("text-body", !isActive);
          });
        });
      },
      { root: null, rootMargin: "0px", threshold: 0.3 },
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
