---
interface DetailedDescription {
  summary: string;
  bullets?: string[];
}

interface Props {
  title: string;
  company: string;
  location: string;
  startDate: string;
  endDate: string;
  description: string | DetailedDescription;
  tags: {
    name: string;
    class: string;
  }[];
}

const { title, company, location, startDate, endDate, description, tags } =
  Astro.props;
---

<div
  class="absolute w-3 h-3 rounded-full mt-[0.65rem] -start-1.5 border border-gray-900 bg-gray-700"
>
</div>
<time class="mb-1 text-sm font-normal leading-none text-gray-500">
  {startDate} - {endDate}
</time>
<h3 class="mt-2 text-lg font-semibold">{title}</h3>
<h2 class="text-sm text-gray-400">{company}, {location}</h2>
{
  typeof description === "string" ? (
    <p class="mb-4 mt-2 text-base font-normal text-gray-500 text-pretty">
      {description}
    </p>
  ) : (
    <div class="mb-4 mt-2 text-base font-normal text-gray-500 text-pretty">
      <p>{description.summary}</p>
      {description.bullets && (
        <ul class="mt-2 list-outside list-disc space-y-1 ps-5">
          {description.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )}
    </div>
  )
}

{
  tags.map((tag) => (
    <span class="inline-block px-2 py-1 mr-2 text-xs font-semibold text-gray-500 uppercase bg-gray-200 rounded">
      {tag.name}
    </span>
  ))
}
