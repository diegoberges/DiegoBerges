---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface DetailedDescription {
  summary: string;
  bullets?: string[];
}

interface Props {
  title: string;
  company: string;
  location: string;
  startDate: string;
  /** Machine-readable start, e.g. "2022-04" */
  startDateTime: string;
  endDate: string;
  /** Machine-readable end; omit for the current role */
  endDateTime?: string;
  description: string | DetailedDescription;
  tags: {
    name: string;
    icon: AstroComponentFactory;
  }[];
}

const {
  title,
  company,
  location,
  startDate,
  startDateTime,
  endDate,
  endDateTime,
  description,
  tags,
} = Astro.props;
const isCurrent = endDate === "Actualmente";
---

{
  isCurrent ? (
    <span
      class="absolute -inset-s-1.5 mt-[0.65rem] flex size-3"
      aria-hidden="true"
    >
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-gray-700 opacity-75 motion-reduce:hidden" />
      <span class="relative inline-flex size-3 rounded-full border border-gray-900 bg-gray-700" />
    </span>
  ) : (
    <div
      class="absolute w-3 h-3 rounded-full mt-[0.65rem] -inset-s-1.5 border border-gray-900 bg-gray-700"
      aria-hidden="true"
    />
  )
}
<span class="mb-1 text-sm font-normal leading-none text-gray-500">
  <time datetime={startDateTime}>{startDate}</time>
  {" - "}
  {endDateTime ? <time datetime={endDateTime}>{endDate}</time> : endDate}
</span>
<h3 class="mt-2 text-lg font-semibold">{title}</h3>
<p class="text-sm text-gray-600">{company}, {location}</p>
{
  typeof description === "string" ? (
    <p class="mb-4 mt-2 max-w-[56ch] text-base font-normal text-gray-700 text-pretty">
      {description}
    </p>
  ) : (
    <div class="mb-4 mt-2 max-w-[56ch] text-base font-normal text-pretty">
      <p class="text-gray-700">{description.summary}</p>
      {description.bullets && (
        <ul class="mt-2 list-outside list-disc space-y-1 ps-5 text-gray-500 marker:text-gray-400">
          {description.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )}
    </div>
  )
}

{
  tags.map((tag) => (
    <span class="inline-flex items-center gap-1.5 px-2 py-1 mr-2 mb-2 text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 rounded-full">
      <tag.icon class="size-3.5" aria-hidden="true" />
      {tag.name}
    </span>
  ))
}
