---
import Github from "./icons/Github.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import SocialPill from "./shared/SocialPill.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav
  aria-label="Redes sociales"
  class:list={["flex flex-wrap gap-2", className]}
>
  <SocialPill href="https://www.linkedin.com/in/diegoberges/">
    <LinkedIn class="size-5" aria-hidden="true" /> LinkedIn
  </SocialPill>

  <SocialPill href="https://github.com/diegoberges">
    <Github class="size-5" aria-hidden="true" /> GitHub
  </SocialPill>
</nav>
