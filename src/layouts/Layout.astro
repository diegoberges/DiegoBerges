---
import "@fontsource-variable/onest";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Página web personal de Diego Berges" } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="Diego Berges" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main
      class="mx-auto w-[800px] max-w-[calc(100%-2rem)] p-4 text-xl leading-[1.6]"
    >
      <slot />
    </main>
    <script>
      import "flowbite";
    </script>
  </body>
</html>
<style is:global>
  html {
    font-family: "Onest Variable", sans-serif;
  }
</style>
